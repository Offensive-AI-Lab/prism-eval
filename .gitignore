# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
dist/
build/
.pytest_cache/

# Secrets — copy .env.example to .env and fill it in
.env

# Model weights. Fetched with scripts/download_weights.py; $PRISM_EVAL_CHECKPOINT_DIR
# defaults here, but ignore the extension anywhere in case it points elsewhere.
checkpoints/
*.pt

# Run outputs
results/
logs/
*.log
*.out

# Regenerable suite-build intermediates (scripts/build_suite.py --*-progress)
data/external/

# The full indirect prompt injection suite and its build intermediates are
# regenerable with scripts/fetch_xpia_evals.py. The smoke suite, scripts,
# and configs are committed.
data/eval_suite_xpia.json
data/xpia_progress.jsonl
# Ignore large intermediates; retain the indirect prompt injection source corpus.
*.parquet
!data/xpia_corpus.parquet

# Editors / OS
.DS_Store
.idea/
.vscode/

# Tooling caches and run outputs
.ruff_cache/
