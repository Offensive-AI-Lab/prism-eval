# prism-eval environment variables.
# Copy to `.env` (git-ignored) and fill in. The CLI loads it automatically.

# ─── Model weights ───────────────────────────────────────────────────────────
# Where the published checkpoints live. Configs reference checkpoints as
# ${PRISM_EVAL_CHECKPOINT_DIR}/<name>.pt, so this is the only path you set.
#   python scripts/download_weights.py --dest "$PRISM_EVAL_CHECKPOINT_DIR"
PRISM_EVAL_CHECKPOINT_DIR=./checkpoints


# ─── Judge LLM ───────────────────────────────────────────────────────────────
# Scores ITM reports against ground truth (see RUBRIC.md). Any
# OpenAI-compatible endpoint works.
#
#   Self-hosted (what the paper used): scripts/serve_judge.sh starts vLLM,
#   then point PRISM_EVAL_BASE_URL at it.
#   Hosted: set PRISM_EVAL_BASE_URL to your provider and use a real key.
#
# NOTE: the judge model is part of the scorer's identity. Changing it makes
# your numbers incomparable to the published ones.
PRISM_EVAL_MODEL=gemma4-31B-it
PRISM_EVAL_BASE_URL=http://localhost:8088/v1
PRISM_EVAL_API_KEY=EMPTY


# ─── Base model (only for rebuilding the suite) ──────────────────────────────
# The model that AP injection scenarios are run through to verify the
# injection actually landed. Needed only by scripts/build_suite.py, not to
# run an evaluation. Falls back to the PRISM_EVAL_* values above when unset.
# PRISM_BASE_MODEL=Qwen/Qwen3.5-9B
# PRISM_BASE_URL=http://localhost:8001/v1
# PRISM_BASE_API_KEY=EMPTY


# ─── Base (subject) models ───────────────────────────────────────────────────
# The model being monitored. Which one is read from the checkpoint, not set
# here — grpo/sft use Qwen3.5-9B, gemma2 uses Gemma-2-9B, ministral3 uses
# Ministral-3-8B. They are pulled from Hugging Face on first use (~17-18 GB
# each), so point the cache at shared storage if you have it:
# HF_HOME=/path/to/shared/models
# HF_HUB_CACHE=/path/to/shared/models/hub


# ─── Optional ────────────────────────────────────────────────────────────────
# Only for the text_only_baseline runner's `baseline_llm` call.
# OPENAI_API_KEY=

# Only when experiment.weave_project is set (i.e. not running --offline).
# WANDB_API_KEY=

# Only if the base model or tokenizer you use is gated on Hugging Face.
# HF_TOKEN=

# Hugging Face org for scripts/download_weights.py (default: Offensive-AI-Lab).
# PRISM_EVAL_WEIGHTS_ORG=Offensive-AI-Lab
